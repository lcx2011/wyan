{
  "name": "wenyan-beisong",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "文言文背诵 PWA —— 面向中小学生的渐进式背诵闯关应用",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:server": "vitest run tests/server",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "preview": "tsx server/index.ts",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@fastify/static": "^8.3.0",
    "@mui/material": "^5.16.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.11.3",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "pinyin-pro": "^3.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^4.1.10"
  }
}
