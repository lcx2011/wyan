# Required only when an existing pre-auth SQLite archive is migrated on startup.
# Keep the real value in /etc/wenyan/wenyan.env or another secret store.
WENYAN_ADMIN_PASSWORD=replace-with-a-random-password

# Production defaults used by deploy/wenyan.service.
NODE_ENV=production
HOST=127.0.0.1
PORT=8878
WENYAN_DB_PATH=/var/lib/wenyan/wenyan.sqlite
