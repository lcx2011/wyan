[Unit]
Description=Wenyan personal study archive
After=network.target

[Service]
Type=simple
User=wenyan
WorkingDirectory=/opt/wenyan
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8878
EnvironmentFile=-/etc/wenyan/wenyan.env
Environment=WENYAN_DB_PATH=/var/lib/wenyan/wenyan.sqlite
ExecStart=/usr/bin/node /opt/wenyan/dist-server/server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
